# Vorlage für lokale Geheimnisse. `npm run dev` legt daraus automatisch eine .env an.
# Die .env wird NIE in Git gespeichert. Hier nur Testwerte eintragen – keine echten (Live-)Schlüssel.

# "development" schaltet lokal den Stripe-Simulator und sichtbare Anmeldecodes frei.
ENVIRONMENT=development

# Zufallswert zum Absichern von Anmeldecodes (wird beim ersten Start automatisch erzeugt).
SESSION_SECRET=__AUTO__

# Stripe TESTMODUS. Leer lassen = lokaler Stripe-Simulator (kein Stripe-Konto nötig).
# Mit echtem Testkonto: Schlüssel beginnt mit sk_test_ (Stripe-Dashboard → Entwickler → API-Schlüssel).
STRIPE_SECRET_KEY=
# Signatur-Geheimnis für Webhooks. Ohne Stripe-Konto: automatisch erzeugter lokaler Wert.
# Mit Testkonto: den Wert aus `stripe listen --forward-to localhost:5173/api/stripe/webhook` eintragen (whsec_…).
STRIPE_WEBHOOK_SECRET=__AUTO__
