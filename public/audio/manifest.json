 },
 "s3589664": {
  "file": "s/s3589664.mp3",
  "text": "今好きな人いる？",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s2278888": {
  "file": "s/s2278888.mp3",
  "text": "質問はありますか？",
  "credit": "Mizu (Tatoeba, CC BY-NC 4.0)"
 },
 "s3553284": {
  "file": "s/s3553284.mp3",
  "text": "どういうこと？",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s2758982": {
  "file": "s/s2758982.mp3",
  "text": "もっと幸せになりたい。",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s2469769": {
  "file": "s/s2469769.mp3",
  "text": "誰にも言うなよ。",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s3625005": {
  "file": "s/s3625005.mp3",
  "text": "昨日一緒にいた女の人誰？",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s3850805": {
  "file": "s/s3850805.mp3",
  "text": "この歌知ってる？",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s152212": {
  "file": "s/s152212.mp3",
  "text": "私もそう思う。",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s2975859": {
  "file": "s/s2975859.mp3",
  "text": "その必要はありません。",
  "credit": "Mizu (Tatoeba, CC BY-NC 4.0)"
 },
 "s161054": {
  "file": "s/s161054.mp3",
  "text": "私はここにいたい。",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s3631723": {
  "file": "s/s3631723.mp3",
  "text": "何か食べたいものある？",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s3560587": {
  "file": "s/s3560587.mp3",
  "text": "それ見せて。",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s2478124": {
  "file": "s/s2478124.mp3",
  "text": "準備できたら電話して。",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s370955": {
  "file": "s/s370955.mp3",
  "text": "何これ？",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s3677754": {
  "file": "s/s3677754.mp3",
  "text": "ここよく来るの？",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s2413229": {
  "file": "s/s2413229.mp3",
  "text": "見てるだけです。",
  "credit": "Mizu (Tatoeba, CC BY-NC 4.0)"
 },
 "s3006685": {
  "file": "s/s3006685.mp3",
  "text": "長い一週間だったな。",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s8769317": {
  "file": "s/s8769317.mp3",
  "text": "行くの？",
  "credit": "fal (Tatoeba, CC BY 4.0)"
 },
 "s2303034": {
  "file": "s/s2303034.mp3",
  "text": "何の話？",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s3093923": {
  "file": "s/s3093923.mp3",
  "text": "これ自分で描いたの？",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s2430004": {
  "file": "s/s2430004.mp3",
  "text": "何考えてるの？",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s195390": {
  "file": "s/s195390.mp3",
  "text": "また明日。",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s3550819": {
  "file": "s/s3550819.mp3",
  "text": "今の音何？",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s3453236": {
  "file": "s/s3453236.mp3",
  "text": "もう一回やってみて。",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s3556198": {
  "file": "s/s3556198.mp3",
  "text": "大学ってもっと楽しいところだと思ってた。",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s3559174": {
  "file": "s/s3559174.mp3",
  "text": "理由聞いてもいい？",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s140994": {
  "file": "s/s140994.mp3",
  "text": "前に進んでください。",
  "credit": "huizi99 (Tatoeba, CC BY-NC 4.0)"
 },
 "s1619851": {
  "file": "s/s1619851.mp3",
  "text": "明日の夜とかどう？",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s2992030": {
  "file": "s/s2992030.mp3",
  "text": "午後の会議、出る？",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s3484283": {
  "file": "s/s3484283.mp3",
  "text": "こんな時間まで何してたの？",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s3552890": {
  "file": "s/s3552890.mp3",
  "text": "何書いてんの？",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s2991029": {
  "file": "s/s2991029.mp3",
  "text": "二人ともありがとう。",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s3455785": {
  "file": "s/s3455785.mp3",
  "text": "今携帯持ってる？",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s4438542": {
  "file": "s/s4438542.mp3",
  "text": "コメントありがとうございます。",
  "credit": "Mizu (Tatoeba, CC BY-NC 4.0)"
 },
 "s187729": {
  "file": "s/s187729.mp3",
  "text": "何に使うの？",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s2774232": {
  "file": "s/s2774232.mp3",
  "text": "何の話ですか？",
  "credit": "Mizu (Tatoeba, CC BY-NC 4.0)"
 },
 "s2419784": {
  "file": "s/s2419784.mp3",
  "text": "それ取ってくれる？",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s2718656": {
  "file": "s/s2718656.mp3",
  "text": "電話してくれればよかったのに。",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s3114652": {
  "file": "s/s3114652.mp3",
  "text": "これ誰の本ですか？",
  "credit": "Mizu (Tatoeba, CC BY-NC 4.0)"
 },
 "s2604697": {
  "file": "s/s2604697.mp3",
  "text": "ここは病院です。",
  "credit": "Mizu (Tatoeba, CC BY-NC 4.0)"
 },
 "s3010178": {
  "file": "s/s3010178.mp3",
  "text": "目に何か入った。",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s127078": {
  "file": "s/s127078.mp3",
  "text": "知らなかったの？",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s3452060": {
  "file": "s/s3452060.mp3",
  "text": "今日の夜予定ある？",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s187048": {
  "file": "s/s187048.mp3",
  "text": "家の外で待っていてください。",
  "credit": "huizi99 (Tatoeba, CC BY-NC 4.0)"
 },
 "s3558987": {
  "file": "s/s3558987.mp3",
  "text": "何歳か聞いてもいい？",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s3169400": {
  "file": "s/s3169400.mp3",
  "text": "私もそんな気がする。",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s2664558": {
  "file": "s/s2664558.mp3",
  "text": "親にはもう話しました。",
  "credit": "Mizu (Tatoeba, CC BY-NC 4.0)"
 },
 "s2518677": {
  "file": "s/s2518677.mp3",
  "text": "分かってます。",
  "credit": "Mizu (Tatoeba, CC BY-NC 4.0)"
 },
 "s2871761": {
  "file": "s/s2871761.mp3",
  "text": "何読んでるの？",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s4147428": {
  "file": "s/s4147428.mp3",
  "text": "入ってもいいですか？",
  "credit": "Mizu (Tatoeba, CC BY-NC 4.0)"
 },
 "s4751203": {
  "file": "s/s4751203.mp3",
  "text": "仕事はどうですか？",
  "credit": "Mizu (Tatoeba, CC BY-NC 4.0)"
 },
 "s2835421": {
  "file": "s/s2835421.mp3",
  "text": "私も同じこと考えてた。",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s3423802": {
  "file": "s/s3423802.mp3",
  "text": "ちょっと見ていただきたいものがあるんですけど。",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s143718": {
  "file": "s/s143718.mp3",
  "text": "水をください。",
  "credit": "huizi99 (Tatoeba, CC BY-NC 4.0)"
 },
 "s3513020": {
  "file": "s/s3513020.mp3",
  "text": "もう一回最初からやってみたら？",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s2492791": {
  "file": "s/s2492791.mp3",
  "text": "どういう意味？",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
 "s3596583": {
  "file": "s/s3596583.mp3",
  "text": "そんなこと言うなよ。",
  "credit": "yomi (Tatoeba, CC BY-NC 4.0)"
 },
