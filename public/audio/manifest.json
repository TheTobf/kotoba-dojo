  "credit": "VOICEVOX:四国めたん"
 },
 "w1920240": {
  "file": "w/w1920240.mp3",
  "text": "どの",
  "credit": "VOICEVOX:青山龍星"
 },
 "w1208360": {
  "file": "w/w1208360.mp3",
  "text": "かつどう",
  "credit": "VOICEVOX:四国めたん"
 },
 "w1447690": {
  "file": "w/w1447690.mp3",
  "text": "とうきょう",
  "credit": "VOICEVOX:青山龍星"
 },
 "w1277450": {
  "file": "w/w1277450.mp3",
  "text": "すき",
  "credit": "VOICEVOX:四国めたん"
 },
 "w1577140": {
  "file": "w/w1577140.mp3",
  "text": "どこ",
  "credit": "VOICEVOX:青山龍星"
 },
 "w1590560": {
  "file": "w/w1590560.mp3",
  "text": "かなり",
  "credit": "VOICEVOX:四国めたん"
 },
 "w1004880": {
  "file": "w/w1004880.mp3",
  "text": "こんな",
  "credit": "VOICEVOX:青山龍星"
 },
 "w1356700": {
  "file": "w/w1356700.mp3",
  "text": "じょうきょう",
  "credit": "VOICEVOX:四国めたん"
 },
 "w1361490": {
  "file": "w/w1361490.mp3",
  "text": "あたらしい",
  "credit": "VOICEVOX:青山龍星"
 },
 "w1529520": {
  "file": "w/w1529520.mp3",
  "text": "ない",
  "credit": "VOICEVOX:四国めたん"
 },
 "w1236070": {
  "file": "w/w1236070.mp3",
  "text": "つよい",
  "credit": "VOICEVOX:青山龍星"
 },
 "w1214200": {
  "file": "w/w1214200.mp3",
  "text": "かんり",
  "credit": "VOICEVOX:四国めたん"
 },
 "w1454670": {
  "file": "w/w1454670.mp3",
  "text": "とくに",
  "credit": "VOICEVOX:青山龍星"
 },
 "w1213280": {
  "file": "w/w1213280.mp3",
  "text": "かんきょう",
  "credit": "VOICEVOX:四国めたん"
 },
 "w1120410": {
  "file": "w/w1120410.mp3",
  "text": "ページ",
  "credit": "VOICEVOX:青山龍星"
 },
 "w1420800": {
  "file": "w/w1420800.mp3",
  "text": "ちいき",
  "credit": "VOICEVOX:四国めたん"
 },
 "w1307550": {
  "file": "w/w1307550.mp3",
  "text": "はじめる",
  "credit": "VOICEVOX:青山龍星"
 },
 "w1611580": {
  "file": "w/w1611580.mp3",
  "text": "ほんとうに",
  "credit": "VOICEVOX:四国めたん"
 },
 "w1151260": {
  "file": "w/w1151260.mp3",
  "text": "わるい",
  "credit": "VOICEVOX:青山龍星"
 },
 "w1321110": {
  "file": "w/w1321110.mp3",
  "text": "じっさい",
  "credit": "VOICEVOX:四国めたん"
 },
 "w1424270": {
  "file": "w/w1424270.mp3",
  "text": "ちゅうごく",
  "credit": "VOICEVOX:青山龍星"
 },
 "w1308090": {
  "file": "w/w1308090.mp3",
  "text": "し",
  "credit": "VOICEVOX:四国めたん"
 },
 "w1387210": {
  "file": "w/w1387210.mp3",
  "text": "さき",
  "credit": "VOICEVOX:青山龍星"
 },
 "w1416830": {
  "file": "w/w1416830.mp3",
  "text": "だれ",
  "credit": "VOICEVOX:四国めたん"
 },
 "w1264770": {
  "file": "w/w1264770.mp3",
  "text": "こじん",
  "credit": "VOICEVOX:青山龍星"
 },
 "w1156530": {
  "file": "w/w1156530.mp3",
  "text": "いけん",
  "credit": "VOICEVOX:四国めたん"
 },
 "w1356730": {
  "file": "w/w1356730.mp3",
  "text": "じょうたい",
  "credit": "VOICEVOX:青山龍星"
 },
 "w1294940": {
  "file": "w/w1294940.mp3",
  "text": "さい",
  "credit": "VOICEVOX:四国めたん"
 },
 "s8531386": {
  "file": "s/s8531386.mp3",
  "text": "お好きなように。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s11825864": {
  "file": "s/s11825864.mp3",
  "text": "一年って、何日？",
  "credit": "VOICEVOX:四国めたん"
 },
 "s12461920": {
  "file": "s/s12461920.mp3",
  "text": "いい日だった？",
  "credit": "VOICEVOX:青山龍星"
 },
 "s175677": {
  "file": "s/s175677.mp3",
  "text": "月が出た。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s175221": {
  "file": "s/s175221.mp3",
  "text": "犬を中に入れるな。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s187722": {
  "file": "s/s187722.mp3",
  "text": "何のために？",
  "credit": "VOICEVOX:四国めたん"
 },
 "s1582710c": {
  "file": "s/s1582710c.mp3",
  "text": "日本に行きたいです。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s1293333": {
  "file": "s/s1293333.mp3",
  "text": "私たちは努力しております。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s100139": {
  "file": "s/s100139.mp3",
  "text": "彼は変わってしまった。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s1516930c": {
  "file": "s/s1516930c.mp3",
  "text": "こっちの方がいいよ。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s2825431": {
  "file": "s/s2825431.mp3",
  "text": "時は金なり。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s4848": {
  "file": "s/s4848.mp3",
  "text": "何が問題なの？",
  "credit": "VOICEVOX:四国めたん"
 },
 "s2190027": {
  "file": "s/s2190027.mp3",
  "text": "あるわけがない。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s1006730c": {
  "file": "s/s1006730c.mp3",
  "text": "ご飯を食べて、そして寝た。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s1175570c": {
  "file": "s/s1175570c.mp3",
  "text": "このペンは百円です。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s189576": {
  "file": "s/s189576.mp3",
  "text": "雨の場合私は行かない。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s178881": {
  "file": "s/s178881.mp3",
  "text": "君が必要だ。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s1736638": {
  "file": "s/s1736638.mp3",
  "text": "具体的な情報が欲しい。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s189135": {
  "file": "s/s189135.mp3",
  "text": "英語は簡単でない、しかし面白い。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s100315": {
  "file": "s/s100315.mp3",
  "text": "彼は舞台の上にたっている。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s1589060c": {
  "file": "s/s1589060c.mp3",
  "text": "会議は明日行います。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s1502840c": {
  "file": "s/s1502840c.mp3",
  "text": "あと五分待って。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s1853758": {
  "file": "s/s1853758.mp3",
  "text": "三時十分です。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s8716633": {
  "file": "s/s8716633.mp3",
  "text": "多すぎる？",
  "credit": "VOICEVOX:四国めたん"
 },
 "s3856780": {
  "file": "s/s3856780.mp3",
  "text": "関係ないよ。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s6921824": {
  "file": "s/s6921824.mp3",
  "text": "彼は委員に選ばれました。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s1269320c": {
  "file": "s/s1269320c.mp3",
  "text": "後で電話するね。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s3488178": {
  "file": "s/s3488178.mp3",
  "text": "そういうこと。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s1373860c": {
  "file": "s/s1373860c.mp3",
  "text": "世界は広いね。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s77855": {
  "file": "s/s77855.mp3",
  "text": "良い点を取ろうと努力をした。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s120143": {
  "file": "s/s120143.mp3",
  "text": "彼が勝つほうに一万円かけるよ。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s185083": {
  "file": "s/s185083.mp3",
  "text": "海をバックに記念写真撮ろうよ。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s2973587": {
  "file": "s/s2973587.mp3",
  "text": "社会が変化している。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s933128": {
  "file": "s/s933128.mp3",
  "text": "彼は別のトラックにいるんです。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s150841": {
  "file": "s/s150841.mp3",
  "text": "事故の数が増えた。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s1657754": {
  "file": "s/s1657754.mp3",
  "text": "記事を一つ書きたい。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s102315": {
  "file": "s/s102315.mp3",
  "text": "彼は誰？",
  "credit": "VOICEVOX:青山龍星"
 },
 "s8631613": {
  "file": "s/s8631613.mp3",
  "text": "ドイツは大きな国だ。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s205018": {
  "file": "s/s205018.mp3",
  "text": "全部で三千円です。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s1771926": {
  "file": "s/s1771926.mp3",
  "text": "君は誰？",
  "credit": "VOICEVOX:四国めたん"
 },
 "s85428": {
  "file": "s/s85428.mp3",
  "text": "必要以上の水がある。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s109044": {
  "file": "s/s109044.mp3",
  "text": "彼は会社員です。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s3459079": {
  "file": "s/s3459079.mp3",
  "text": "先生によれば、私はよい生徒だそうです。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s188359": {
  "file": "s/s188359.mp3",
  "text": "俺は人間だ。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s1263650c": {
  "file": "s/s1263650c.mp3",
  "text": "現在、東京に住んでいます。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s3552880": {
  "file": "s/s3552880.mp3",
  "text": "何作ってるの？",
  "credit": "VOICEVOX:四国めたん"
 },
 "s1218190c": {
  "file": "s/s1218190c.mp3",
  "text": "大きな企業で働いています。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s1215230c": {
  "file": "s/s1215230c.mp3",
  "text": "駅と家の間に公園があります。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s10796441": {
  "file": "s/s10796441.mp3",
  "text": "理論上は可能です。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s188407": {
  "file": "s/s188407.mp3",
  "text": "何か感じる。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s3272096": {
  "file": "s/s3272096.mp3",
  "text": "金を出せ！",
  "credit": "VOICEVOX:青山龍星"
 },
 "s3388468": {
  "file": "s/s3388468.mp3",
  "text": "研究室に戻りなさい。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s1447180c": {
  "file": "s/s1447180c.mp3",
  "text": "インスタに写真を投稿した。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s1203260c": {
  "file": "s/s1203260c.mp3",
  "text": "他に質問はありますか？",
  "credit": "VOICEVOX:四国めたん"
 },
 "s1143400c": {
  "file": "s/s1143400c.mp3",
  "text": "リンクを送ってくれる？",
  "credit": "VOICEVOX:青山龍星"
 },
 "s3893114": {
  "file": "s/s3893114.mp3",
  "text": "是非またお願い致します。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s3073523": {
  "file": "s/s3073523.mp3",
  "text": "高すぎる！",
  "credit": "VOICEVOX:青山龍星"
 },
 "s11846527": {
  "file": "s/s11846527.mp3",
  "text": "次は、私？",
  "credit": "VOICEVOX:四国めたん"
 },
 "s4865772": {
  "file": "s/s4865772.mp3",
  "text": "最近こういう映画多くない？",
  "credit": "VOICEVOX:青山龍星"
 },
 "s173469": {
  "file": "s/s173469.mp3",
  "text": "考えておくよ。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s1507528": {
  "file": "s/s1507528.mp3",
  "text": "僕だよ！",
  "credit": "VOICEVOX:青山龍星"
 },
 "s120673": {
  "file": "s/s120673.mp3",
  "text": "彼から大きな影響を受けた。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s107977": {
  "file": "s/s107977.mp3",
  "text": "彼は経済の専門家だ。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s8802478": {
  "file": "s/s8802478.mp3",
  "text": "で、あなたは？",
  "credit": "VOICEVOX:四国めたん"
 },
 "s104507": {
  "file": "s/s104507.mp3",
  "text": "彼は手が大きい。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s8692017": {
  "file": "s/s8692017.mp3",
  "text": "そこにまだある？",
  "credit": "VOICEVOX:四国めたん"
 },
 "s77886": {
  "file": "s/s77886.mp3",
  "text": "良い結果が予想される。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s117077": {
  "file": "s/s117077.mp3",
  "text": "彼の車は私のと似ている。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s1242590c": {
  "file": "s/s1242590c.mp3",
  "text": "お金がない。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s185954": {
  "file": "s/s185954.mp3",
  "text": "我々は科学技術の時代に住んでいる。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s1376070c": {
  "file": "s/s1376070c.mp3",
  "text": "政府は新しい法律を作った。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s100720": {
  "file": "s/s100720.mp3",
  "text": "彼は非常に重要な人物だ。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s3496789": {
  "file": "s/s3496789.mp3",
  "text": "それもあり得る。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s1459400c": {
  "file": "s/s1459400c.mp3",
  "text": "内容がよくわからなかった。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s9756354": {
  "file": "s/s9756354.mp3",
  "text": "とても心が広いんですね。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s2464037": {
  "file": "s/s2464037.mp3",
  "text": "ただなの？",
  "credit": "VOICEVOX:四国めたん"
 },
 "s1055810c": {
  "file": "s/s1055810c.mp3",
  "text": "このサイトは便利です。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s237051": {
  "file": "s/s237051.mp3",
  "text": "教育は家庭に始まる。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s764119": {
  "file": "s/s764119.mp3",
  "text": "私は女性です。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s137751": {
  "file": "s/s137751.mp3",
  "text": "大きすぎるわ。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s234269": {
  "file": "s/s234269.mp3",
  "text": "あなたかあるいは私が間違っている。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s1430228": {
  "file": "s/s1430228.mp3",
  "text": "再利用するの？",
  "credit": "VOICEVOX:四国めたん"
 },
 "s92823": {
  "file": "s/s92823.mp3",
  "text": "彼女はさらにもっと美しい。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s1225130c": {
  "file": "s/s1225130c.mp3",
  "text": "日本の技術はすごい。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s8511059": {
  "file": "s/s8511059.mp3",
  "text": "参加したい。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s198813": {
  "file": "s/s198813.mp3",
  "text": "なんと大きな犬だろう。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s11574658": {
  "file": "s/s11574658.mp3",
  "text": "いい感じ。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s2772770c": {
  "file": "s/s2772770c.mp3",
  "text": "やはり雨が降った。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s404045": {
  "file": "s/s404045.mp3",
  "text": "うちにいます。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s226471": {
  "file": "s/s226471.mp3",
  "text": "カードを入れてください。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s8572172": {
  "file": "s/s8572172.mp3",
  "text": "家が見える。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s1920240c": {
  "file": "s/s1920240c.mp3",
  "text": "どの色が好き？",
  "credit": "VOICEVOX:四国めたん"
 },
 "s1213334": {
  "file": "s/s1213334.mp3",
  "text": "彼は活動的な人だ。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s1447690c": {
  "file": "s/s1447690c.mp3",
  "text": "東京に行ったことがありますか？",
  "credit": "VOICEVOX:四国めたん"
 },
 "s2041050": {
  "file": "s/s2041050.mp3",
  "text": "かなりいい気分だ。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s123195": {
  "file": "s/s123195.mp3",
  "text": "難しい状況です。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s205062": {
  "file": "s/s205062.mp3",
  "text": "それは新しいです。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s84021": {
  "file": "s/s84021.mp3",
  "text": "風の強い日です。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s1214200c": {
  "file": "s/s1214200c.mp3",
  "text": "時間の管理が苦手です。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s12142838": {
  "file": "s/s12142838.mp3",
  "text": "その時は、特に何も思わなかった。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s3093933": {
  "file": "s/s3093933.mp3",
  "text": "ドイツ人は環境に対する意識が非常に高い。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s82028": {
  "file": "s/s82028.mp3",
  "text": "僕はまだその小説の最後のページを読んでいない。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s11023140": {
  "file": "s/s11023140.mp3",
  "text": "地域で差がありすぎる。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s442923": {
  "file": "s/s442923.mp3",
  "text": "始めましょう。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s81560": {
  "file": "s/s81560.mp3",
  "text": "本当に？",
  "credit": "VOICEVOX:青山龍星"
 },
 "s138013": {
  "file": "s/s138013.mp3",
  "text": "体に悪いよ。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s166994": {
  "file": "s/s166994.mp3",
  "text": "私たちの計画は実際にはうまく行かなかった。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s9106958": {
  "file": "s/s9106958.mp3",
  "text": "中国にいるよ。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s188892": {
  "file": "s/s188892.mp3",
  "text": "駅は市の中央にある。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s195419": {
  "file": "s/s195419.mp3",
  "text": "まだ先は長い。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s205128": {
  "file": "s/s205128.mp3",
  "text": "それは私の個人用のものです。",
  "credit": "VOICEVOX:青山龍星"
 },
 "s1156530c": {
  "file": "s/s1156530c.mp3",
  "text": "あなたの意見を聞かせてください。",
  "credit": "VOICEVOX:四国めたん"
 },
 "s117676": {
  "file": "s/s117676.mp3",
  "text": "彼の健康状態はよくない。",
  "credit": "VOICEVOX:青山龍星"
 }
}