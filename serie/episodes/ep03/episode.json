{
 "id": "ep03",
 "staffel": 1,
 "folge": 3,
 "titel": "Der Fahrkarten-Automat",
 "problem": "Ohne Fahrkarte kommt Knö nicht in die Stadt – aber wo kauft man die?",
 "cliffhanger": "Der Mann mit dem Hut drückt für Knö einen Knopf. Auf der Fahrkarte steht: Shinjuku.",
 "neu": [
  "c042"
 ],
 "wiederholung": [
  "c001"
 ],
 "naechste": "Morgen: Folge 4 – Welcher Zug?",
 "segmente": [
  {
   "id": "s01",
   "art": "erzaehler",
   "text": "Knö steht im Bahnhof. Hunderte Menschen. Alle wissen, wohin.",
   "regie": "spannend"
  },
  {
   "id": "s02",
   "art": "erzaehler",
   "text": "Nur Knö nicht. Und ohne Fahrkarte geht hier gar nichts."
  },
  {
   "id": "s03",
   "art": "erzaehler",
   "text": "Da vorne steht jemand vom Bahnpersonal. Erst mal: das Zauberwort von gestern."
  },
  {
   "id": "s04",
   "art": "japanisch",
   "sprecher": "knoe",
   "curriculum": "c001"
  },
  {
   "id": "s05",
   "art": "erzaehler",
   "text": "Der Mann dreht sich um. Und jetzt?"
  },
  {
   "id": "s06",
   "art": "erzaehler",
   "text": "Fahrkarte heißt kippu. Wo kann ich kaufen, heißt doko de kaemasu ka."
  },
  {
   "id": "s07",
   "art": "quiz"
  },
  {
   "id": "s08",
   "art": "japanisch",
   "sprecher": "knoe",
   "curriculum": "c042",
   "wiederholen": true
  },
  {
   "id": "s09",
   "art": "erzaehler",
   "text": "Kippu wa doko de kaemasu ka. Wo kann ich eine Fahrkarte kaufen?",
   "regie": "stolz"
  },
  {
   "id": "s10",
   "art": "japanisch",
   "sprecher": "personal2",
   "text": "あちらの券売機です",
   "kana": "あちらのけんばいきです",
   "romaji": "achira no kenbaiki desu",
   "de": "Dort drüben am Fahrkartenautomaten.",
   "karte": "klein"
  },
  {
   "id": "s11",
   "art": "erzaehler",
   "text": "Kenbaiki heißt Fahrkartenautomat. Achira kennt Knö schon: dort drüben."
  },
  {
   "id": "s12",
   "art": "erzaehler",
   "text": "Knö steht vor dem Automaten. Hundert Knöpfe. Alles auf Japanisch."
  },
  {
   "id": "s13",
   "art": "erzaehler",
   "text": "Knö drückt einfach irgendwas. Piep. Piep. Piiiep.",
   "regie": "verzweifelt"
  },
  {
   "id": "s14",
   "art": "erzaehler",
   "text": "Da greift eine Hand an Knö vorbei und drückt einen Knopf."
  },
  {
   "id": "s15",
   "art": "erzaehler",
   "text": "Es ist wieder der Mann mit dem Hut. Eine Fahrkarte fällt heraus.",
   "regie": "geheimnisvoll"
  },
  {
   "id": "s16",
   "art": "erzaehler",
   "text": "Darauf steht: Shinjuku. Woher weiß er, wohin Knö will?",
   "regie": "spannend"
  }
 ],
