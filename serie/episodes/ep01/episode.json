{
 "id": "ep01",
 "staffel": 1,
 "folge": 1,
 "titel": "Platsch!",
 "problem": "Knö steht an der Einreise. Die Beamtin fragt etwas – und Knös Übersetzer-Handy liegt im Brunnen.",
 "cliffhanger": "Knö ist in Japan – aber ohne Handy. Wie kommt Knö jetzt in die Stadt?",
 "neu": [
  "c030",
  "c031"
 ],
 "wiederholung": [],
 "naechste": "Morgen: Folge 2 – Ganz dringend!",
 "segmente": [
  {
   "id": "s01",
   "art": "erzaehler",
   "regie": "spannend",
   "text": "Knö ist gerade in Japan gelandet. Und versteht kein einziges Wort."
  },
  {
   "id": "s02",
   "art": "erzaehler",
   "text": "Schuld ist eine alte Postkarte vom Dachboden."
  },
  {
   "id": "s03",
   "art": "erzaehler",
   "regie": "geheimnisvoll",
   "text": "Darauf ein Laternenladen am Meer. Und nur ein Satz: Komm jederzeit vorbei."
  },
  {
   "id": "s04",
   "art": "erzaehler",
   "text": "Also hat Knö einfach einen Flug gebucht. Kein Plan. Kein Japanisch."
  },
  {
   "id": "s05",
   "art": "erzaehler",
   "regie": "stolz",
   "text": "Aber Knö hat ja ein Handy mit Übersetzer-App."
  },
  {
   "id": "s06",
   "art": "erzaehler",
   "text": "Nur noch schnell ein Foto vom Brunnen …"
  },
  {
   "id": "s07",
   "art": "erzaehler",
   "regie": "erschrocken",
   "text": "Platsch."
  },
  {
   "id": "s08",
   "art": "erzaehler",
   "regie": "trocken",
   "text": "Handy weg. Übersetzer weg. Und jetzt ist Knö dran."
  },
  {
   "id": "s09",
   "art": "japanisch",
   "sprecher": "personal",
   "text": "次の方、どうぞ",
   "kana": "つぎのかた、どうぞ",
   "romaji": "tsugi no kata, douzo",
   "de": "Der Nächste, bitte.",
   "karte": "klein"
  },
  {
   "id": "s10",
   "art": "erzaehler",
   "text": "Die Beamtin schaut Knö an und fragt:"
  },
  {
   "id": "s11",
   "art": "japanisch",
   "sprecher": "personal",
   "curriculum": "c030"
  },
  {
   "id": "s12",
   "art": "erzaehler",
   "regie": "verwirrt",
   "text": "[[目的|mokuteki]]? Ist das etwas zu essen?"
  },
  {
   "id": "s13",
   "art": "erzaehler",
   "text": "[[目的|mokuteki]] heißt Zweck. Sie will wissen: Warum bist du hier?"
  },
  {
   "id": "s14",
   "art": "erzaehler",
   "text": "Knö will Japan anschauen. Als Tourist."
  },
  {
   "id": "s15",
   "art": "quiz"
  },
  {
   "id": "s16",
   "art": "japanisch",
   "sprecher": "knoe",
   "curriculum": "c031",
   "wiederholen": true
  },
  {
   "id": "s17",
   "art": "erzaehler",
   "regie": "freudig",
   "text": "[[観光|kankō]] heißt Tourismus. Kurz, höflich, perfekt."
  },
  {
   "id": "s18",
   "art": "erzaehler",
   "text": "Die Beamtin nickt. Stempel. Knö darf rein!"
  },
  {
   "id": "s19",
   "art": "japanisch",
   "sprecher": "personal",
   "text": "ようこそ、日本へ",
   "kana": "ようこそ、にほんへ",
   "romaji": "youkoso, nihon e",
   "de": "Willkommen in Japan.",
   "karte": "klein"
  },
  {
   "id": "s20",
   "art": "erzaehler",
   "regie": "spannend",
   "text": "Aber dann steht Knö vor dem Bahnplan. Hunderte Zeichen. Kein Handy."
  },
  {
   "id": "s21",
   "art": "erzaehler",
   "regie": "leise",
   "text": "Und plötzlich muss Knö ganz dringend aufs Klo."
  }
 ],
