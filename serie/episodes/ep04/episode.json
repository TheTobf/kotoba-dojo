{
 "id": "ep04",
 "staffel": 1,
 "folge": 4,
 "titel": "Welcher Zug?",
 "problem": "Auf Gleis 3 halten zwei Züge – nur einer fährt nach Shinjuku.",
 "cliffhanger": "Knö sitzt im richtigen Zug – und der Magen knurrt so laut, dass der ganze Waggon guckt.",
 "neu": [
  "c027"
 ],
 "wiederholung": [
  "c001"
 ],
 "naechste": "Morgen: Folge 5 – Onigiri-Notfall",
 "segmente": [
  {
   "id": "s01",
   "art": "erzaehler",
   "text": "Gleis drei. Zwei Züge. Einer fährt nach Shinjuku. Aber welcher?",
   "regie": "hektisch"
  },
  {
   "id": "s02",
   "art": "japanisch",
   "sprecher": "ansage",
   "curriculum": "c045",
   "karte": "klein"
  },
  {
   "id": "s03",
   "art": "erzaehler",
   "text": "Mamonaku heißt: gleich. Gleich fährt ein Zug ein!"
  },
  {
   "id": "s03b",
   "art": "erzaehler",
   "text": "Zwei Züge, zwei Gleise. Und die Anzeige wechselt viel zu schnell."
  },
  {
   "id": "s04",
   "art": "erzaehler",
   "text": "Neben Knö wartet eine junge Frau. Knö nimmt allen Mut zusammen."
  },
  {
   "id": "s05",
   "art": "japanisch",
   "sprecher": "knoe",
   "curriculum": "c001"
  },
  {
   "id": "s06",
   "art": "erzaehler",
   "text": "Jetzt die Frage: Fährt dieser Zug nach Shinjuku?"
  },
  {
   "id": "s07",
   "art": "erzaehler",
   "text": "Kono densha heißt dieser Zug. Ni ikimasu ka heißt: fährt er nach …?"
  },
  {
   "id": "s08",
   "art": "quiz"
  },
  {
   "id": "s09",
   "art": "japanisch",
   "sprecher": "knoe",
   "curriculum": "c027",
   "wiederholen": true
  },
  {
   "id": "s10",
   "art": "erzaehler",
   "text": "Kono densha wa Shinjuku ni ikimasu ka. Ein ganzer Satz!",
   "regie": "stolz"
  },
  {
   "id": "s11",
   "art": "japanisch",
   "sprecher": "personal",
   "text": "はい、行きますよ",
   "kana": "はい、いきますよ",
   "romaji": "hai, ikimasu yo",
   "de": "Ja, der fährt dahin.",
   "karte": "klein"
  },
  {
   "id": "s12",
   "art": "erzaehler",
   "text": "Hai heißt ja. Knö springt in den Zug.",
   "regie": "erleichtert"
  },
  {
   "id": "s13",
   "art": "japanisch",
   "sprecher": "ansage",
   "curriculum": "c046",
   "karte": "klein"
  },
  {
   "id": "s14",
   "art": "erzaehler",
   "text": "Die Türen schließen. Geschafft! Knö fährt durch Tokio."
  },
  {
   "id": "s15",
   "art": "erzaehler",
   "text": "Aber dann knurrt Knös Magen. So laut, dass der ganze Waggon guckt.",
   "regie": "spannend"
  },
  {
   "id": "s16",
   "art": "erzaehler",
   "text": "Knö hat seit dem Flug nichts gegessen.",
   "regie": "leise"
  }
 ],
