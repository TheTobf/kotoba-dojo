 "staffel": 1,
 "folge": 6,
 "titel": "Die Kassen-Fragen",
 "problem": "Haru stellt an der Kasse Fragen – Aufwärmen? Tüte? – und Knö muss höflich Nein sagen.",
 "cliffhanger": "Haru kann Deutsch?! Aber draußen wird es dunkel, und Knö hat noch kein Hotel gefunden.",
 "neu": [
  "c017",
  "c004"
 ],
 "wiederholung": [
  "c010"
 ],
 "naechste": "Morgen: Folge 7 – Hotel Kamome",
 "segmente": [
  {
   "id": "s01",
   "art": "erzaehler",
   "text": "Knö steht an der Kasse. Haru fragt etwas, und die Schlange wartet.",
   "regie": "hektisch"
  },
  {
   "id": "s01b",
   "art": "erzaehler",
   "text": "Knö kennt bisher nur: Das hier, bitte. Das reicht jetzt nicht mehr."
  },
  {
   "id": "s02",
   "art": "japanisch",
   "sprecher": "haru",
   "curriculum": "c017"
  },
  {
   "id": "s03",
   "art": "erzaehler",
   "text": "Atatamemasu ka. Soll ich das aufwärmen?"
  },
  {
   "id": "s04",
   "art": "erzaehler",
   "text": "Ein warmer Reisball? Knö will lieber nicht. Aber wie sagt man höflich nein?"
  },
  {
   "id": "s05",
   "art": "erzaehler",
   "text": "Ein Satz hilft fast immer: Daijōbu desu. Alles gut, passt schon."
  },
  {
   "id": "s05b",
   "art": "erzaehler",
   "text": "Höflich, kurz und ohne Ärger. Perfekt für alle Fragen an der Kasse."
  },
  {
   "id": "s06",
   "art": "quiz"
  },
  {
   "id": "s07",
   "art": "japanisch",
   "sprecher": "knoe",
   "curriculum": "c004",
   "wiederholen": true
  },
  {
   "id": "s08",
   "art": "erzaehler",
   "text": "Daijōbu desu. Haru nickt und lächelt.",
   "regie": "erleichtert"
  },
  {
   "id": "s09",
   "art": "japanisch",
   "sprecher": "haru",
   "curriculum": "c016",
   "karte": "klein"
  },
  {
   "id": "s10",
   "art": "erzaehler",
   "text": "Eine Tüte? Braucht Knö nicht. Also nochmal:"
  },
  {
   "id": "s11",
   "art": "japanisch",
   "sprecher": "knoe",
   "curriculum": "c004",
   "karte": "klein"
  },
  {
   "id": "s12",
   "art": "erzaehler",
   "text": "Dann zeigt Knö noch auf ein Getränk."
  },
  {
   "id": "s13",
   "art": "japanisch",
   "sprecher": "knoe",
   "curriculum": "c010"
  },
  {
   "id": "s14",
   "art": "erzaehler",
   "text": "Haru packt alles zusammen. Und sagt plötzlich auf Deutsch: Gute Reise!",
   "regie": "überrascht"
  },
  {
   "id": "s15",
   "art": "erzaehler",
   "text": "Haru kann Deutsch? Knö will fragen, aber hinter Knö drängelt die Schlange."
  },
  {
   "id": "s15b",
   "art": "erzaehler",
   "text": "Knö winkt nur noch kurz. Und steht wieder draußen."
  },
  {
   "id": "s16",
   "art": "erzaehler",
   "text": "Draußen wird es dunkel. Und Knö hat noch kein Hotel gefunden.",
   "regie": "spannend"
  }
 ],
