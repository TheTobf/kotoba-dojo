{
 "id": "ep02",
 "staffel": 1,
 "folge": 2,
 "titel": "Ganz dringend!",
 "problem": "Knö muss sofort aufs Klo – und versteht kein einziges Schild.",
 "cliffhanger": "Vor der Toilette wartet ein alter Mann mit Hut und zeigt auf einen Automaten.",
 "neu": [
  "c001",
  "c008"
 ],
 "wiederholung": [
  "c031"
 ],
 "naechste": "Morgen: Folge 3 – Der Fahrkarten-Automat",
 "segmente": [
  {
   "id": "s01",
   "art": "erzaehler",
   "text": "Knö muss aufs Klo. Sofort. Und überall nur Zeichen.",
   "regie": "dringend"
  },
  {
   "id": "s02",
   "art": "erzaehler",
   "text": "Knö hüpft von einem Bein aufs andere. Eine Frau vom Infoschalter kommt näher."
  },
  {
   "id": "s03",
   "art": "japanisch",
   "sprecher": "personal",
   "text": "観光ですか",
   "kana": "かんこうですか",
   "romaji": "kankou desu ka",
   "de": "Sind Sie Tourist?",
   "karte": "klein"
  },
  {
   "id": "s04",
   "art": "erzaehler",
   "text": "Das kennt Knö von gestern!",
   "regie": "stolz"
  },
  {
   "id": "s05",
   "art": "japanisch",
   "sprecher": "knoe",
   "curriculum": "c031"
  },
  {
   "id": "s06",
   "art": "erzaehler",
   "text": "Super. Aber das Klo ist damit leider nicht gefunden."
  },
  {
   "id": "s07",
   "art": "erzaehler",
   "text": "Knö macht Pantomime. Die Frau denkt: Knö will tanzen.",
   "regie": "lustig"
  },
  {
   "id": "s08",
   "art": "erzaehler",
   "text": "Zum Glück gibt es ein Zauberwort, um jemanden höflich anzusprechen."
  },
  {
   "id": "s09",
   "art": "japanisch",
   "sprecher": "knoe",
   "curriculum": "c001",
   "wiederholen": true
  },
  {
   "id": "s10",
   "art": "erzaehler",
   "text": "Sumimasen. Das heißt: Entschuldigung, darf ich kurz stören?"
  },
  {
   "id": "s11",
   "art": "erzaehler",
   "text": "Jetzt die Frage. Toilette heißt toire. Wo ist … heißt wa doko desu ka."
  },
  {
   "id": "s12",
   "art": "quiz"
  },
  {
   "id": "s13",
   "art": "japanisch",
   "sprecher": "knoe",
   "curriculum": "c008",
   "wiederholen": true
  },
  {
   "id": "s14",
   "art": "erzaehler",
   "text": "Toire wa doko desu ka. Die Frau lächelt und zeigt nach links.",
   "regie": "erleichtert"
  },
  {
   "id": "s15",
   "art": "japanisch",
   "sprecher": "personal",
   "curriculum": "c009",
   "karte": "klein"
  },
  {
   "id": "s16",
   "art": "erzaehler",
   "text": "Otearai heißt auch Toilette. Achira heißt: dort drüben."
  },
  {
   "id": "s17",
   "art": "erzaehler",
   "text": "Knö rennt los. Gerade noch rechtzeitig!"
  },
  {
   "id": "s18",
   "art": "erzaehler",
   "text": "Als Knö wieder rauskommt, steht da ein alter Mann mit Hut.",
   "regie": "spannend"
  },
  {
   "id": "s19",
   "art": "erzaehler",
   "text": "Er zeigt auf einen Automaten voller Knöpfe. Und lächelt geheimnisvoll.",
   "regie": "geheimnisvoll"
  }
 ],
