{
 "id": "ep05",
 "staffel": 1,
 "folge": 5,
 "titel": "Onigiri-Notfall",
 "problem": "Knö ist halb verhungert und steht zum ersten Mal in einem Konbini.",
 "cliffhanger": "An der Kasse fragt die Verkäuferin etwas – und noch etwas – und die Schlange wird immer länger.",
 "neu": [
  "c007",
  "c010"
 ],
 "wiederholung": [
  "c008"
 ],
 "naechste": "Morgen: Folge 6 – Die Kassen-Fragen",
 "segmente": [
  {
   "id": "s01",
   "art": "erzaehler",
   "text": "Knö stolpert in einen Konbini. Ein kleiner Laden, rund um die Uhr offen.",
   "regie": "hungrig"
  },
  {
   "id": "s02",
   "art": "erzaehler",
   "text": "Die Tür geht auf und jemand ruft laut:"
  },
  {
   "id": "s03",
   "art": "japanisch",
   "sprecher": "haru",
   "curriculum": "c007"
  },
  {
   "id": "s04",
   "art": "erzaehler",
   "text": "Knö zuckt zusammen. Ist das ein Angriff?",
   "regie": "erschrocken"
  },
  {
   "id": "s05",
   "art": "erzaehler",
   "text": "Nein! [[いらっしゃいませ|irasshaimase]] heißt Willkommen. Antworten muss man nicht. Einfach lächeln."
  },
  {
   "id": "s05b",
   "art": "erzaehler",
   "text": "Die Verkäufer rufen das jedem zu. Auch Knö.",
   "regie": "erleichtert"
  },
  {
   "id": "s06",
   "art": "erzaehler",
   "text": "Aber zuerst: Knö muss schon wieder."
  },
  {
   "id": "s07",
   "art": "japanisch",
   "sprecher": "knoe",
   "curriculum": "c008"
  },
  {
   "id": "s08",
   "art": "japanisch",
   "sprecher": "haru",
   "curriculum": "c009",
   "karte": "klein"
  },
  {
   "id": "s09",
   "art": "erzaehler",
   "text": "Danach steht Knö vor dem Regal. Reisbälle! Onigiri!",
   "regie": "begeistert"
  },
  {
   "id": "s10",
   "art": "erzaehler",
   "text": "Knö nimmt einen und geht zur Kasse. Die Verkäuferin heißt Haru."
  },
  {
   "id": "s10b",
   "art": "erzaehler",
   "text": "Sie trägt eine gelbe Schürze und ein Namensschild. Und sie wartet auf Knö."
  },
  {
   "id": "s11",
   "art": "erzaehler",
   "text": "Wie sagt man jetzt: Das hier, bitte?"
  },
  {
   "id": "s12",
   "art": "quiz"
  },
  {
   "id": "s13",
   "art": "japanisch",
   "sprecher": "knoe",
   "curriculum": "c010",
   "wiederholen": true
  },
  {
   "id": "s14",
   "art": "erzaehler",
   "text": "Das hier, bitte. Funktioniert bei allem, worauf du zeigen kannst.",
   "regie": "stolz"
  },
  {
   "id": "s15",
   "art": "erzaehler",
   "text": "Haru nickt. Dann fragt sie etwas. Und noch etwas. Und noch etwas."
  },
  {
   "id": "s16",
   "art": "erzaehler",
   "text": "Knö versteht kein Wort. Hinter Knö wird die Schlange immer länger.",
   "regie": "panisch"
  }
 ],
