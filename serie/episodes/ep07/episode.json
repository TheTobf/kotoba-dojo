{
 "id": "ep07",
 "staffel": 1,
 "folge": 7,
 "titel": "Hotel Kamome",
 "problem": "Knö erreicht endlich das Hotel – und muss auf Japanisch einchecken.",
 "cliffhanger": "Die Reservierung gilt nur für eine Nacht. Und vor dem Hotel klaut eine Krähe die Postkarte.",
 "neu": [
  "c032",
  "c033"
 ],
 "wiederholung": [
  "c004"
 ],
 "naechste": "Bald: Staffel 2 – Ein Dach über dem Kopf",
 "segmente": [
  {
   "id": "s01",
   "art": "erzaehler",
   "text": "Endlich! Hotel Kamome. Knö schleppt sich zur Rezeption.",
   "regie": "müde"
  },
  {
   "id": "s02",
   "art": "erzaehler",
   "text": "Jetzt braucht Knö zwei Sätze. Erstens: einchecken."
  },
  {
   "id": "s03",
   "art": "erzaehler",
   "text": "Check-in heißt einfach chekkuin. Dazu onegai shimasu: bitte."
  },
  {
   "id": "s04",
   "art": "quiz"
  },
  {
   "id": "s05",
   "art": "japanisch",
   "sprecher": "knoe",
   "curriculum": "c032",
   "wiederholen": true
  },
  {
   "id": "s06",
   "art": "japanisch",
   "sprecher": "personal",
   "text": "ご予約のお名前は",
   "kana": "ごよやくのおなまえは",
   "romaji": "goyoyaku no onamae wa",
   "de": "Auf welchen Namen ist die Reservierung?",
   "karte": "klein"
  },
  {
   "id": "s07",
   "art": "erzaehler",
   "text": "Sie will den Namen. Knö hat unter Omas Namen gebucht: Schmidt."
  },
  {
   "id": "s08",
   "art": "erzaehler",
   "text": "Yoyaku shite iru heißt: Ich habe reserviert. Dann der Name und desu."
  },
  {
   "id": "s09",
   "art": "japanisch",
   "sprecher": "knoe",
   "curriculum": "c033",
   "wiederholen": true
  },
  {
   "id": "s10",
   "art": "erzaehler",
   "text": "Die Frau tippt. Und stutzt.",
   "regie": "stolz"
  },
  {
   "id": "s11",
   "art": "japanisch",
   "sprecher": "personal",
   "text": "一泊のご予約ですね",
   "kana": "いっぱくのごよやくですね",
   "romaji": "ippaku no goyoyaku desu ne",
   "de": "Sie haben eine Nacht reserviert, richtig?",
   "karte": "klein"
  },
  {
   "id": "s12",
   "art": "erzaehler",
   "text": "Ippaku. Eine Nacht. Knö hat nur eine einzige Nacht gebucht!",
   "regie": "geschockt"
  },
  {
   "id": "s13",
   "art": "japanisch",
   "sprecher": "personal",
   "curriculum": "c006",
   "karte": "klein"
  },
  {
   "id": "s14",
   "art": "japanisch",
   "sprecher": "knoe",
   "curriculum": "c004"
  },
  {
   "id": "s15",
   "art": "erzaehler",
   "text": "Knö sagt: Alles gut. Aber nichts ist gut."
  },
  {
   "id": "s16",
   "art": "erzaehler",
   "text": "Vor dem Hotel holt Knö die Postkarte raus. Wo ist dieser Laden bloß?"
  },
  {
   "id": "s17",
   "art": "erzaehler",
   "text": "Da landet etwas Schwarzes auf dem Automaten. Eine Krähe.",
   "regie": "spannend"
  },
  {
   "id": "s18",
   "art": "erzaehler",
   "text": "Sie schnappt sich die Postkarte. Und fliegt davon.",
   "regie": "sehr spannend"
  }
 ],
