    "stripe:setup": "tsx scripts/stripe-setup.ts"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-jp": "^5.3.1",
    "@fontsource/noto-serif-jp": "^5.3.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "hono": "^4.13.18",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "stripe": "^23.1.0",
    "ts-fsrs": "^5.4.2",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/workers-types": "^5.20261116.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/wanakana": "^4.0.6",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
